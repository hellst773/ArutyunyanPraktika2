@dp.message(Command("list"))
async def cmd_list(message: Message):
    chat_id = str(message.chat.id)
    
    available_emails = []
    
    # Своя почта
    if chat_id in users:
        available_emails.append(f"📧 Ваша почта: {users[chat_id]['email']}")
    
    # Почты с доступом
    for owner_id, user_data in users.items():
        if chat_id in user_data["granted_users"]:
            available_emails.append(f"📧 Доступ к: {user_data['email']}")
    
    if not available_emails:
        await message.answer("❌ У вас нет доступных почт. Используйте /start или /access")
        return
    
    await message.answer("\n".join(available_emails))

# ================== КОМАНДА /cod ==================
@dp.message(Command("cod"))
async def cmd_cod(message: Message):
    chat_id = str(message.chat.id)
    
    # Собираем все почты, к которым есть доступ
    emails_to_check = []
    
    if chat_id in users:
        emails_to_check.append({
            "email": users[chat_id]["email"],
            "password": users[chat_id]["password"],
            "imap_server": users[chat_id]["imap_server"]
        })
    
    for owner_id, user_data in users.items():
        if chat_id in user_data["granted_users"]:
            emails_to_check.append({
                "email": user_data["email"],
                "password": user_data["password"],
                "imap_server": user_data["imap_server"]
            })
    
    if not emails_to_check:
        await message.answer("❌ У вас нет доступных почт. Используйте /start или /access")
        return
    
    await message.answer("🔍 Проверяю письма...")
    
    total_found = 0
    for email_config in emails_to_check:
        emails_data = check_email(
            email_config["email"],
            email_config["password"],
            email_config["imap_server"]
        )
        
        if emails_data:
            await message.answer(f"📬 Найдено {len(emails_data)} новых писем из {email_config['email']}:")
            
            for email_data in emails_data:
                full_message = (
                    f"📧 *Новое письмо от {email_data['from']}*\n"
                    f"📅 {email_data['date']}\n"
                    f"📌 Тема: {email_data['subject']}\n\n"
                    f"{email_data['body']}"
                )
                
                try:
                    await message.answer(full_message, parse_mode="Markdown")
                except:
                    await message.answer(full_message)
                
                total_found += 1
    
    if total_found == 0:
        await message.answer("📭 Нет новых писем от sso@mirea.ru")
    else:
        await message.answer(f"✅ Всего найдено и отправлено: {total_found} писем")

# ================== КОМАНДА /logout ==================
@dp.message(Command("logout"))
async def cmd_logout(message: Message):
    chat_id = str(message.chat.id)
    
    if chat_id not in users:
        await message.answer("❌ Вы не зарегистрированы.")
        return
    
    # Удаляем код доступа
    code = users[chat_id]["universal_code"]
    if code in access_codes:
        del access_codes[code]
    
    # Удаляем пользователя
    del users[chat_id]
    
    save_users(users)
    save_access_codes(access_codes)
    
    await message.answer("👋 Вы вышли из аккаунта. Используйте /start для новой регистрации.")

# ================== КОМАНДА /cancel ==================
@dp.message(Command("cancel"))
async def cmd_cancel(message: Message, state: FSMContext):
    await state.clear()
    await message.answer("❌ Действие отменено.")

# ================== ЗАПУСК ==================
async def main():
    logger.info("Бот запущен. Ожидание команд...")
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main)
```

## 🎯 Основные изменения:

### 1. **Система регистрации**
- При первом `/start` запрашивается email, пароль и IMAP-сервер
- Данные сохраняются в `users.json`
- Генерируется уникальный 9-символьный код

### 2. **Универсальный код доступа**
- Каждый пользователь получает свой код (например: `ABC123XYZ`)
- Код можно передать другому человеку
- Второй человек вводит код через `/access` и получает доступ к почте первого

### 3. **Команды**:
- `/start` - Регистрация/приветствие
- `/cod` - Проверить ВСЕ доступные почты
- `/mycode` - Показать свой код
- `/access` - Ввести чужой код
- `/list` - Список доступных почт
- `/logout` - Выход из аккаунта
- `/cancel` - Отмена текущего действия

### 4. **Безопасность**:
- Пароли хранятся локально (можно добавить шифрование)
- Сообщения с паролями удаляются

### 5. **Файлы данных**:
- `users.json` - данные пользователей
- `access_codes.json` - привязка кодов к владельцам

