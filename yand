@dp.callback_query(F.data == "logout")
async def callback_logout(callback: CallbackQuery):
   chat_id = str(callback.from_user.id)

   if chat_id not in users:
       await callback.answer("❌ Вы не зарегистрированы!", show_alert=True)
       return

   code = users[chat_id]["universal_code"]
   if code in access_codes:
       del access_codes[code]
   
   # Удаляем этого пользователя из гостевых доступов других
   granted_users = users[chat_id]["granted_users"].copy()
   for guest_id in granted_users:
       if guest_id in guest_access and chat_id in guest_access[guest_id]:
           guest_access[guest_id].remove(chat_id)
           if len(guest_access[guest_id]) == 0:
               del guest_access[guest_id]
   
   del users[chat_id]

   save_users(users)
   save_access_codes(access_codes)
   save_guest_access(guest_access)

   await callback.message.edit_text(
       "👋 Вы вышли из аккаунта.\n\n"
       "Ваши данные удалены.",
       reply_markup=get_main_menu_keyboard(chat_id)
   )
   await callback.answer()


