@dp.callback_query(F.data.startswith("imap_"))
async def callback_imap_select(callback: CallbackQuery, state: FSMContext):
    imap_servers = {
        "imap_yandex": "imap.yandex.ru",
        "imap_gmail": "imap.gmail.com",
        "imap_mailru": "imap.mail.ru"
    }
    
    imap_server = imap_servers.get(callback.data)
    if imap_server:
        await callback.message.edit_text(f"⏳ Выбран сервер: {imap_server}\n\nПроверяю подключение...")
        await callback.answer()
        
        # Имитируем ввод сервера
        fake_message = types.Message(
            message_id=callback.message.message_id,
            date=callback.message.date,
            chat=callback.message.chat,
            from_user=callback.from_user,
            text=imap_server
        )
        fake_message.answer = callback.message.answer
        fake_message.delete = callback.message.delete
        
        await process_imap_server(fake_message, state)

