@dp.message(StateFilter(RegistrationStates.waiting_for_email))
async def process_email(message: Message, state: FSMContext):
    email_address = message.text.strip()
    
    if "@" not in email_address or "." not in email_address:
        await message.answer(
            "❌ Некорректный email!\n\n"
            "Email должен содержать @ и домен (например: user@yandex.ru)\n\n"
            "Попробуйте снова:",
            reply_markup=get_cancel_keyboard()
        )
        return
    
    await state.update_data(email=email_address)
    await message.answer(
        f"✅ Email сохранен: {email_address}\n\n"
        "🔒 Теперь введите пароль от почты:\n\n"
        "⚠️ Важно:\n"
        "• Для Яндекс/Gmail нужен пароль приложения, а не основной пароль\n"
        "• Пароль будет проверен при подключении\n"
        "• Сообщение с паролем будет удалено автоматически",
        reply_markup=get_cancel_keyboard()
    )
    await state.set_state(RegistrationStates.waiting_for_password)

