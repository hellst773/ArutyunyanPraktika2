@dp.message(Command("access"))
async def cmd_access(message: Message, state: FSMContext):
    await message.answer("🔐 Введите универсальный код доступа:")
    await state.set_state(AccessCodeStates.waiting_for_code)

@dp.message(StateFilter(AccessCodeStates.waiting_for_code))
async def process_access_code(message: Message, state: FSMContext):
    code = message.text.strip().upper()
    chat_id = str(message.chat.id)
    
    if code not in access_codes:
        await message.answer("❌ Неверный код. Попробуйте снова или /cancel")
        return
    
    owner_id = access_codes[code]
    
    if owner_id == chat_id:
        await message.answer("❌ Это ваш собственный код!")
        await state.clear()
        return
    
    # Добавляем пользователя в список granted_users владельца
    if chat_id not in users[owner_id]["granted_users"]:
        users[owner_id]["granted_users"].append(chat_id)
        save_users(users)
    
    await message.answer(
        f"✅ Доступ получен!\n\n"
        f"Теперь вы можете проверять почту владельца этого кода.\n"
        f"Используйте /list для просмотра доступных почт."
    )
    await state.clear()

