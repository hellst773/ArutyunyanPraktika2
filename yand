@dp.callback_query(F.data == "check_mail")
async def callback_check_mail(callback: CallbackQuery):
   chat_id = str(callback.from_user.id)

   emails_to_check = []

   # Добавляем свою почту если зарегистрирован
   if chat_id in users:
       emails_to_check.append({
           "email": users[chat_id]["email"],
           "password": users[chat_id]["password"],
           "imap_server": users[chat_id]["imap_server"]
       })

   # Добавляем почты, к которым есть гостевой доступ
   if chat_id in guest_access:
       for owner_id in guest_access[chat_id]:
           if owner_id in users:
               emails_to_check.append({
                   "email": users[owner_id]["email"],
                   "password": users[owner_id]["password"],
                   "imap_server": users[owner_id]["imap_server"]
               })

   if not emails_to_check:
       await callback.answer("❌ У вас нет доступных почт!", show_alert=True)
       return

   await callback.message.edit_text("🔍 Проверяю письма...")
   await callback.answer()

   total_found = 0
   for email_config in emails_to_check:
       try:
           emails_data = check_email(
               email_config["email"],
               email_config["password"],
               email_config["imap_server"]
           )

           if emails_data:
               await callback.message.answer(f"📬 Найдено {len(emails_data)} новых писем из {email_config['email']}:")

               for email_data in emails_data:
                   full_message = (
                       f"📧 *Новое письмо от {email_data['from']}*\n"
                       f"📅 {email_data['date']}\n"
                       f"📌 Тема: {email_data['subject']}\n\n"
                       f"{email_data['body']}"
                   )

                   try:
                       await callback.message.answer(full_message, parse_mode="Markdown")
                   except:
                       await callback.message.answer(full_message)
                   total_found += 1
       except Exception as e:
           await callback.message.answer(f"❌ Ошибка при проверке {email_config['email']}: {str(e)}")
   
   if total_found == 0:
       await callback.message.answer(
           "📭 Нет новых писем от sso@mirea.ru",
           reply_markup=get_main_menu_keyboard(chat_id)
       )
   else:
       await callback.message.answer(
           f"✅ Всего найдено: {total_found} писем",
           reply_markup=get_main_menu_keyboard(chat_id)
       )


