@dp.message(StateFilter(RegistrationStates.waiting_for_imap_server))
async def process_imap_server(message: Message, state: FSMContext):
    imap_server = message.text.strip()
    data = await state.get_data()
    
    email_account = data["email"]
    password = data["password"]
    
    status_msg = await message.answer("⏳ Проверяю подключение к почте...")
    
    try:
        mail = imaplib.IMAP4_SSL(imap_server, CONFIG["IMAP_PORT"])
        mail.login(email_account, password)
        mail.logout()
    except imaplib.IMAP4.error as e:
        await status_msg.edit_text(
            f"❌ Ошибка авторизации!\n\n"
            f"Возможные причины:\n"
            f"• Неверный логин или пароль\n"
            f"• Нужен пароль приложения (не основной пароль)\n"
            f"• Не включен доступ по IMAP в настройках почты\n\n"
            f"Детали: {str(e)}\n\n"
            f"Попробуйте снова или выберите другой сервер:",
            reply_markup=get_imap_help_keyboard()
        )
        return
    except Exception as e:
        await status_msg.edit_text(
            f"❌ Ошибка подключения!\n\n"
            f"Проверьте:\n"
            f"• IMAP сервер введен правильно\n"
            f"• Есть интернет соединение\n\n"
            f"Детали: {str(e)}\n\n"
            f"Попробуйте снова:",
            reply_markup=get_cancel_keyboard()
        )
        return
    
    universal_code = generate_universal_code()
    while universal_code in access_codes:
        universal_code = generate_universal_code()
    
    chat_id = str(message.chat.id)
    
    users[chat_id] = {
        "email": email_account,
        "password": password,
        "imap_server": imap_server,
        "universal_code": universal_code,
        "granted_users": []
    }
    
    access_codes[universal_code] = chat_id
    
    save_users(users)
    save_access_codes(access_codes)
    
    await status_msg.edit_text(
        f"✅ Регистрация успешна!\n\n"
        f"🔑 Ваш универсальный код:\n`{universal_code}`\n\n"
        f"📧 Почта: {email_account}\n"
        f"🌐 Сервер: {imap_server}\n\n"
        f"💡 Передайте этот код другим пользователям для доступа к вашей почте.",
        parse_mode="Markdown",
        reply_markup=get_main_menu_keyboard(True)
    )
    await state.clear()

