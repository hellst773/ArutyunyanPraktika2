@dp.message(StateFilter(AccessCodeStates.waiting_for_code))
async def process_access_code(message: Message, state: FSMContext):
    code = message.text.strip().upper()
    chat_id = str(message.chat.id)
    
    if code not in access_codes:
        await message.answer(
            "❌ Неверный код!\n\n"
            "Проверьте правильность ввода и попробуйте снова:",
            reply_markup=get_cancel_keyboard()
        )
        return
    
    owner_id = access_codes[code]
    
    if owner_id == chat_id:
        await message.answer(
            "❌ Это ваш собственный код!\n\n"
            "Выберите действие:",
            reply_markup=get_main_menu_keyboard(True)
        )
        await state.clear()
        return
    
    if chat_id not in users[owner_id]["granted_users"]:
        users[owner_id]["granted_users"].append(chat_id)
        save_users(users)
    owner_email = users[owner_id]["email"]
    
    await message.answer(
        f"✅ Доступ получен!\n\n"
        f"📧 Почта: {owner_email}\n\n"
        f"Теперь вы можете проверять письма с этой почты.",
        reply_markup=get_main_menu_keyboard(chat_id in users)
    )
    await state.clear()

