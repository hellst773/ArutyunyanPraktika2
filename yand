def decode_mime_string(encoded: str) -> str:
    decoded_parts = decode_header(encoded)
    result = ""
    for part, charset in decoded_parts:
        if isinstance(part, bytes):
            if charset is None:
                try:
                    result += part.decode('utf-8', errors='replace')
                except:
                    result += part.decode('latin-1', errors='replace')
            else:
                try:
                    result += part.decode(charset, errors='replace')
                except LookupError:
                    try:
                        result += part.decode('utf-8', errors='replace')
                    except:
                        result += part.decode('latin-1', errors='replace')
        else:
            result += part
    return result

def _decode_payload(payload: bytes, charset: str = None) -> str:
    if charset is None:
        charset = 'utf-8'
    try:
        return payload.decode(charset, errors='replace')
    except LookupError:
        try:
            return payload.decode('utf-8', errors='replace')
        except:
            return payload.decode('latin-1', errors='replace')

def get_email_body(msg) -> str:
    if msg.is_multipart():
        for part in msg.walk():
            content_type = part.get_content_type()
            content_disposition = str(part.get("Content-Disposition"))
            if "attachment" in content_disposition:
                continue
            if content_type == "text/plain":
                payload = part.get_payload(decode=True)
                charset = part.get_content_charset()
                return _decode_payload(payload, charset)elif content_type == "text/html":
                payload = part.get_payload(decode=True)
                charset = part.get_content_charset()
                text = _decode_payload(payload, charset)
                text = re.sub(r"<[^>]+>", "", text)
                return text
    else:
        payload = msg.get_payload(decode=True)
        charset = msg.get_content_charset()
        return _decode_payload(payload, charset)
    return "[Не удалось извлечь текст письма]"

# ================== ПРОВЕРКА ПОЧТЫ ==================
def check_email(email_account: str, email_password: str, imap_server: str) -> List[Dict]:
    try:
        mail = imaplib.IMAP4_SSL(imap_server, CONFIG["IMAP_PORT"])
        mail.login(email_account, email_password)
        mail.select("inbox")

        search_criterion = f'(UNSEEN FROM "{CONFIG["SENDER_EMAIL"]}")'
        result, data = mail.uid("search", None, search_criterion)

        if result != "OK":
            mail.logout()
            return []

        uids = data[0].split()
        if not uids:
            mail.logout()
            return []

        uids = [int(uid) for uid in uids if uid.isdigit()]
        uids.sort()

        emails_data = []
        for uid in uids:
            result, msg_data = mail.uid("fetch", str(uid), "(RFC822)")
            if result != "OK":
                continue

            raw_email = msg_data[0][1]
            msg = email.message_from_bytes(raw_email)

            from_ = decode_mime_string(msg.get("From", ""))
            subject = decode_mime_string(msg.get("Subject", ""))
            date = parsedate_to_datetime(msg.get("Date"))
            body = get_email_body(msg)

            emails_data.append({
                "from": from_,
                "subject": subject,
                "date": date.strftime('%Y-%m-%d %H:%M:%S'),
                "body": body,
                "uid": uid
            })mail.uid("store", str(uid), "+FLAGS", "\\Seen")

        mail.logout()
        return emails_data

    except Exception as e:
        logger.error(f"Ошибка при проверке почты: {e}")
        raise

