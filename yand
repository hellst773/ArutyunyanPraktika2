# ================== РЕГИСТРАЦИЯ ==================
@dp.message(StateFilter(RegistrationStates.waiting_for_email))
async def process_email(message: Message, state: FSMContext):
    email_address = message.text.strip()
    
    if "@" not in email_address:
        await message.answer("❌ Некорректный email. Попробуйте снова:")
        return
    
    await state.update_data(email=email_address)
    await message.answer("📧 Email сохранен!\n\nТеперь введите пароль от почты (пароль приложения):")
    await state.set_state(RegistrationStates.waiting_for_password)

@dp.message(StateFilter(RegistrationStates.waiting_for_password))
async def process_password(message: Message, state: FSMContext):
    password = message.text.strip()
    await state.update_data(password=password)
    
    # Удаляем сообщение с паролем для безопасности
    try:
        await message.delete()
    except:
        pass
    
    await message.answer(
        "🔒 Пароль сохранен!\n\n"
        "Теперь введите IMAP сервер вашей почты:\n"
        "Примеры:\n"
        "• imap.yandex.ru (для Яндекс)\n"
        "• imap.gmail.com (для Gmail)\n"
        "• imap.mail.ru (для Mail.ru)"
    )
    await state.set_state(RegistrationStates.waiting_for_imap_server)

@dp.message(StateFilter(RegistrationStates.waiting_for_imap_server))
async def process_imap_server(message: Message, state: FSMContext):
    imap_server = message.text.strip()
    data = await state.get_data()
    
    email_account = data["email"]
    password = data["password"]
    
    await message.answer("⏳ Проверяю подключение к почте...")
    
    # Проверяем подключение
    try:
        mail = imaplib.IMAP4_SSL(imap_server, CONFIG["IMAP_PORT"])
        mail.login(email_account, password)
        mail.logout()
    except Exception as e:
        await message.answer(
            f"❌ Ошибка подключения: {str(e)}\n\n"
            f"Проверьте данные и попробуйте снова. Введите IMAP сервер:"
        )
        return
    
    # Генерируем универсальный код
    universal_code = generate_universal_code()
    while universal_code in access_codes:
        universal_code = generate_universal_code()
    
    chat_id = str(message.chat.id)
    
    # Сохраняем пользователя
    users[chat_id] = {
        "email": email_account,
        "password": password,
        "imap_server": imap_server,
        "universal_code": universal_code,
        "granted_users": []
    }
    
    access_codes[universal_code] = chat_id
    
    save_users(users)
    save_access_codes(access_codes)
    
    await message.answer(
        f"✅ Регистрация успешна!\n\n"
        f"🔑 Ваш универсальный код: `{universal_code}`\n\n"
        f"Этот код можно передать другим пользователям, чтобы они получили доступ к вашей почте.\n\n"
        f"Используйте /cod для проверки почты.",
        parse_mode="Markdown"
    )
    await state.clear()

